# -------------------------------------------------------------
# LLM Provider Configuration
# -------------------------------------------------------------
# Option A: 100% Offline & Token-Free via Ollama (Recommended for speed & privacy)
# Requires running Ollama locally: 'ollama run qwen2.5:3b'
LLM_PROVIDER=ollama
AGENT_MODEL=qwen2.5:3b

# Option B: Cloud High-Performance / Free Tier via OpenRouter
# If Ollama is not running, the app automatically falls back to OpenRouter.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Recommended high-performance OpenRouter models:
# - nex-agi/nex-n2.5-pro:free (Fast, free, supports spatial reasoning & tool calling)
# - deepseek/deepseek-v4-flash-0731:free
# - qwen/qwen-2.5-72b-instruct
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free

# -------------------------------------------------------------
# Prototype Deployment
# -------------------------------------------------------------
# Set to true to automatically generate a public 72-hour Gradio live URL for client demos
SHARE_PROTOTYPE=false

# -------------------------------------------------------------
# 100% Offline Mode (Hugging Face)
# -------------------------------------------------------------
# Silences Hugging Face warnings and skips external network checks on startup
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
